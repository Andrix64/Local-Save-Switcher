<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lss.App.Localization"
             xmlns:vm="using:Lss.App.ViewModels"
             x:Class="Lss.App.Views.PlaythroughCardView"
             x:DataType="vm:PlaythroughViewModel">

  <!-- Partita nel gioco: azioni sotto i dati. Le altre: azioni a destra. -->
  <Border Classes="card" Classes.active="{Binding IsActive}"
          IsEnabled="{Binding Enabled}"
          AutomationProperties.Name="{Binding AccessibleName}"
          Margin="0,0,0,10">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="cardTitle" Text="{Binding Name}" VerticalAlignment="Center" />
          <!-- La preferita è piena; le altre hanno il contorno e si cliccano per farle preferite. -->
          <Button Classes="link" Content="☆" Command="{Binding SetFavouriteCommand}"
                  IsVisible="{Binding !IsFavourite}" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding FavouriteTooltip}" AutomationProperties.Name="{Binding FavouriteTooltip}" />
          <TextBlock Text="★" VerticalAlignment="Center" IsVisible="{Binding IsFavourite}"
                     ToolTip.Tip="{Binding FavouriteTooltip}" AutomationProperties.Name="{Binding FavouriteTooltip}" />
          <Border Classes="pill" IsVisible="{Binding IsActive}" VerticalAlignment="Center">
            <TextBlock Text="{loc:Str InGameNow}" />
          </Border>
        </StackPanel>

        <!-- Con MaxWidth e senza allineamento Avalonia centra il testo: va a sinistra. -->
        <TextBlock Classes="note" Text="{Binding Note}" TextWrapping="Wrap"
                   IsVisible="{Binding HasNote}" MaxWidth="420" HorizontalAlignment="Left" />

        <TextBlock Classes="small" Text="{Binding Details}" TextWrapping="Wrap" MaxWidth="440"
                   HorizontalAlignment="Left" />

        <Button Classes="link" Content="{loc:Str AddNote}" Margin="0,2,0,0" HorizontalAlignment="Left"
                IsVisible="{Binding !HasNote}" Command="{Binding EditNoteCommand}" />
      </StackPanel>

      <!-- Partite non nel gioco: Gioca e ⋯ a destra. -->
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center" IsVisible="{Binding !IsActive}">
        <Button Classes="primary" Content="{Binding PlayText}" Command="{Binding PlayCommand}"
                IsEnabled="{Binding CanPlay}" IsVisible="{Binding ShowPlay}" />
        <Button Classes="more"
                AutomationProperties.Name="{Binding MoreActionsName}">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Ellipse />
            <Ellipse />
            <Ellipse />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{loc:Str LoadWithoutStarting}" Command="{Binding LoadOnlyCommand}"
                        IsEnabled="{Binding CanPlay}" />
              <MenuItem Header="{loc:Str RenameMenu}" Command="{Binding RenameCommand}" />
              <MenuItem Header="{loc:Str EditNote}" Command="{Binding EditNoteCommand}" />
              <MenuItem Header="{loc:Str ExportMenu}" Command="{Binding ExportCommand}" />
              <Separator />
              <MenuItem Header="{loc:Str DeletePlaythroughMenu}" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <!-- Partita nel gioco: Gioca, Salva un punto, Cronologia e ⋯ sotto i dati. -->
      <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                  Spacing="8" Margin="0,10,0,0" IsVisible="{Binding IsActive}">
        <Button Classes="secondary" Content="{Binding PlayText}" Command="{Binding PlayCommand}"
                IsEnabled="{Binding CanPlay}" IsVisible="{Binding ShowPlay}" />
        <Button Classes="secondary" Content="{loc:Str SavePointButton}" Command="{Binding SavePointCommand}"
                IsEnabled="{Binding CanPlay}" />
        <Button Classes="secondary" Content="{loc:Str HistoryButton}" Command="{Binding HistoryCommand}" />
        <Button Classes="more"
                AutomationProperties.Name="{Binding MoreActionsName}">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Ellipse />
            <Ellipse />
            <Ellipse />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{loc:Str RenameMenu}" Command="{Binding RenameCommand}" />
              <MenuItem Header="{loc:Str EditNote}" Command="{Binding EditNoteCommand}" />
              <MenuItem Header="{loc:Str ExportMenu}" Command="{Binding ExportCommand}" />
              <Separator />
              <MenuItem Header="{loc:Str DeletePlaythroughMenu}" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}" ToolTip.Tip="{loc:Str ActiveCannotBeDeleted}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

    </Grid>
  </Border>

</UserControl>
