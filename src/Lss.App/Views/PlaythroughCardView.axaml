<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lss.App.Localization"
             xmlns:vm="using:Lss.App.ViewModels"
             x:Class="Lss.App.Views.PlaythroughCardView"
             x:DataType="vm:PlaythroughViewModel">

  <!-- Come il design (canvas "Avanzata"): una riga sola. ★ preferita, nome, dati, azioni a destra. -->
  <UserControl.Styles>
    <Style Selector="Button.star">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.star:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceSelected}" />
      <Setter Property="Foreground" Value="{StaticResource Warning}" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.more.small">
      <Setter Property="Width" Value="36" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Classes.active="{Binding IsActive}"
          IsEnabled="{Binding Enabled}"
          AutomationProperties.Name="{Binding AccessibleName}"
          Padding="12,12,14,12"
          Margin="0,0,0,8">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">

      <!-- La preferita è la stella gialla; le altre hanno il contorno e si cliccano per farle preferite. -->
      <Button Grid.Column="0" Classes="star" Content="☆" Command="{Binding SetFavouriteCommand}"
              IsVisible="{Binding !IsFavourite}"
              ToolTip.Tip="{Binding FavouriteTooltip}" AutomationProperties.Name="{Binding FavouriteTooltip}" />
      <TextBlock Grid.Column="0" Text="★" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource Warning}" IsVisible="{Binding IsFavourite}"
                 ToolTip.Tip="{Binding FavouriteTooltip}" AutomationProperties.Name="{Binding FavouriteTooltip}" />

      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" MaxWidth="320" />

      <!-- Il floppy inserito: la partita nel gioco adesso (la fessura del lettore e il floppy che vi entra). -->
      <Panel Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center" IsVisible="{Binding IsActive}"
             ToolTip.Tip="{loc:Str InGameNow}" AutomationProperties.Name="{loc:Str InGameNow}">
        <Border Height="3" Width="24" CornerRadius="2" Background="{StaticResource TextMuted}"
                VerticalAlignment="Top" HorizontalAlignment="Center" />
        <Path Data="{StaticResource FloppyIcon}" Width="20" Height="20" Stretch="Uniform" Margin="0,5,0,0"
              Stroke="{StaticResource Accent}" Fill="{StaticResource AccentSoft}" StrokeThickness="1.8"
              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
      </Panel>

      <TextBlock Grid.Column="3" Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextMuted}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />

      <!-- Azioni: nel gioco Salva un punto e Cronologia; le altre Gioca questa. Poi ⋯. -->
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="primary small" Content="{Binding PlayText}" Command="{Binding PlayCommand}"
                IsEnabled="{Binding CanPlay}" IsVisible="{Binding ShowPlay}" />
        <Button Classes="ghost small" Content="{loc:Str SavePointButton}" Command="{Binding SavePointCommand}"
                IsEnabled="{Binding CanPlay}" IsVisible="{Binding IsActive}" />
        <Button Classes="ghost small" Content="{loc:Str HistoryButton}" Command="{Binding HistoryCommand}"
                IsVisible="{Binding IsActive}" />
        <Button Classes="more small" AutomationProperties.Name="{Binding MoreActionsName}">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Ellipse />
            <Ellipse />
            <Ellipse />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{loc:Str LoadWithoutStarting}" Command="{Binding LoadOnlyCommand}"
                        IsEnabled="{Binding CanPlay}" IsVisible="{Binding !IsActive}" />
              <MenuItem Header="{loc:Str RenameMenu}" Command="{Binding RenameCommand}" />
              <MenuItem Header="{loc:Str EditNote}" Command="{Binding EditNoteCommand}" />
              <MenuItem Header="{loc:Str ExportMenu}" Command="{Binding ExportCommand}" />
              <MenuItem Header="{loc:Str GiveToMenu}" Command="{Binding GiveToMenuCommand}" />
              <Separator />
              <MenuItem Header="{loc:Str DeletePlaythroughMenu}" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <!-- La nota, se c'è, sotto il nome (si scrive dal menu ⋯) -->
      <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Classes="note" Text="{Binding Note}"
                 TextWrapping="Wrap" FontSize="12" Margin="0,2,0,2" IsVisible="{Binding HasNote}" />
    </Grid>
  </Border>

</UserControl>
