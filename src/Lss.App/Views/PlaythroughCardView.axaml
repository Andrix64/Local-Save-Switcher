<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lss.App.Localization"
             xmlns:vm="using:Lss.App.ViewModels"
             x:Class="Lss.App.Views.PlaythroughCardView"
             x:DataType="vm:PlaythroughViewModel">

  <!-- Come il design (canvas "Avanzata"): una riga sola. ★ preferita, nome, dati, azioni a destra. -->
  <UserControl.Styles>
    <Style Selector="Button.star">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.star:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceSelected}" />
      <Setter Property="Foreground" Value="{StaticResource Warning}" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.more.small">
      <Setter Property="Width" Value="36" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Classes.active="{Binding IsActive}"
          IsEnabled="{Binding Enabled}"
          AutomationProperties.Name="{Binding AccessibleName}"
          Padding="12,12,14,12"
          Margin="0,0,0,8">
    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">

      <!-- Il floppy inserito: la partita nel gioco adesso, con l'etichetta in alto a destra. -->
      <Panel Grid.Column="0" Grid.RowSpan="2" Width="58" Height="48" VerticalAlignment="Center"
             IsVisible="{Binding IsActive}" ToolTip.Tip="{loc:Str InGameNow}"
             AutomationProperties.Name="{loc:Str InGameNow}">
        <Border Width="44" Height="42" CornerRadius="10" Background="{StaticResource Header}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom">
          <Path Data="{StaticResource FloppyIcon}" Width="24" Height="24" Stretch="Uniform"
                Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeLineCap="Round"
                StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border CornerRadius="6" Background="{StaticResource Accent}" Padding="5,1" HorizontalAlignment="Right"
                VerticalAlignment="Top">
          <TextBlock Text="{loc:Str CurrentPlaythrough}" FontSize="9" FontWeight="Bold" Foreground="White" />
        </Border>
      </Panel>

      <!-- La preferita è la stella gialla; le altre hanno il contorno e si cliccano per farle preferite. -->
      <Button Grid.Column="1" Classes="star" Content="☆" Command="{Binding SetFavouriteCommand}"
              IsVisible="{Binding !IsFavourite}"
              ToolTip.Tip="{Binding FavouriteTooltip}" AutomationProperties.Name="{Binding FavouriteTooltip}" />
      <TextBlock Grid.Column="1" Text="★" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource Warning}" IsVisible="{Binding IsFavourite}"
                 ToolTip.Tip="{Binding FavouriteTooltip}" AutomationProperties.Name="{Binding FavouriteTooltip}" />

      <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" MaxWidth="320" />

      <TextBlock Grid.Column="3" Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextMuted}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />

      <!-- Azioni a icone (il nome è nel suggerimento): Gioca; nel gioco anche Salva un punto e Cronologia. Poi ⋯. -->
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="primary small" Command="{Binding PlayCommand}" Width="40" Padding="0"
                IsEnabled="{Binding CanPlay}" IsVisible="{Binding ShowPlay}"
                ToolTip.Tip="{Binding PlayText}" AutomationProperties.Name="{Binding PlayText}">
          <Path Data="M8 5 L19 12 L8 19 Z" Width="14" Height="14" Stretch="Uniform" Fill="White" Stroke="White"
                StrokeThickness="1.5" StrokeJoin="Round" />
        </Button>
        <Button Classes="iconbtn" Command="{Binding SavePointCommand}"
                IsEnabled="{Binding CanPlay}" IsVisible="{Binding IsActive}"
                ToolTip.Tip="{loc:Str SavePointButton}" AutomationProperties.Name="{loc:Str SavePointButton}">
          <Path Width="18" Height="18"
                Data="M19 21 L12 16 L5 21 V5 A2 2 0 0 1 7 3 H17 A2 2 0 0 1 19 5 Z M12 7 V12 M9.5 9.5 H14.5" />
        </Button>
        <Button Classes="iconbtn" Command="{Binding HistoryCommand}" IsVisible="{Binding IsActive}"
                ToolTip.Tip="{loc:Str HistoryButton}" AutomationProperties.Name="{loc:Str HistoryButton}">
          <Path Width="18" Height="18" Data="M12 7 V12 L15 14 M21 12 A9 9 0 1 1 3 12 A9 9 0 0 1 21 12 Z" />
        </Button>
        <Button Classes="more small" AutomationProperties.Name="{Binding MoreActionsName}">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Ellipse />
            <Ellipse />
            <Ellipse />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{loc:Str LoadWithoutStarting}" Command="{Binding LoadOnlyCommand}"
                        IsEnabled="{Binding CanPlay}" IsVisible="{Binding !IsActive}" />
              <MenuItem Header="{loc:Str RenameMenu}" Command="{Binding RenameCommand}" />
              <MenuItem Header="{loc:Str EditNote}" Command="{Binding EditNoteCommand}" />
              <MenuItem Header="{loc:Str ExportMenu}" Command="{Binding ExportCommand}" />
              <MenuItem Header="{loc:Str GiveToMenu}" Command="{Binding GiveToMenuCommand}" />
              <Separator />
              <MenuItem Header="{loc:Str DeletePlaythroughMenu}" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <!-- La nota, se c'è, sotto il nome (si scrive dal menu ⋯) -->
      <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Classes="note" Text="{Binding Note}"
                 TextWrapping="Wrap" FontSize="12" Margin="0,2,0,2" IsVisible="{Binding HasNote}" />
    </Grid>
  </Border>

</UserControl>
