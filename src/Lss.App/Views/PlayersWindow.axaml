<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Lss.App.Localization"
        xmlns:vm="using:Lss.App.ViewModels"
        x:Class="Lss.App.Views.PlayersWindow"
        x:DataType="vm:PlayersViewModel"
        Title="Local Save Switcher"
        Width="720" SizeToContent="Height"
        MinHeight="300"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="28,22,28,24" Spacing="14">

    <TextBlock Classes="title" Text="{loc:Str PlayersTitle}" FontSize="20" />

    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PlayerRow">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{Binding Brush}" Margin="0,0,10,0">
              <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBox Grid.Column="1" Text="{Binding EditName, Mode=TwoWay}" MaxLength="30" Margin="0,0,8,0" />
            <Button Grid.Column="2" Classes="secondary" Content="{loc:Str RenameMenu}" Tag="{Binding}"
                    Click="Rename_Click" Margin="0,0,6,0" />
            <Button Grid.Column="3" Classes="secondary" Content="●" Tag="{Binding}"
                    Click="Colour_Click" ToolTip.Tip="{Binding Person.Color}" Margin="0,0,6,0" />
            <CheckBox Grid.Column="4" Content="{loc:Str PlayerAdmin}" IsChecked="{Binding Person.IsAdmin}"
                      ToolTip.Tip="{loc:Str PlayerAdminTooltip}" Tag="{Binding}" Click="Admin_Click" Margin="0,0,6,0" />
            <Button Grid.Column="5" Classes="secondary" Content="↑" Tag="{Binding}" Click="Up_Click" Margin="0,0,4,0" />
            <Button Grid.Column="6" Classes="secondary" Content="↓" Tag="{Binding}" Click="Down_Click" Margin="0,0,6,0" />
            <Button Grid.Column="7" Classes="secondary" Content="{loc:Str RemovePlayer}" Tag="{Binding}"
                    Click="Remove_Click" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}"
               Foreground="{StaticResource Error}" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox x:Name="NewName" Width="260" MaxLength="30" PlaceholderText="{loc:Str AddPlayer}" />
      <Button Classes="primary" Content="{loc:Str AddPlayer}" Click="Add_Click" />
    </StackPanel>

  </StackPanel>

</Window>
