<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Lss.App.Localization"
        xmlns:vm="using:Lss.App.ViewModels"
        xmlns:core="using:Lss"
        x:Class="Lss.App.Views.NewPlaythroughWindow"
        x:DataType="vm:NewPlaythroughViewModel"
        Title="{Binding Heading}"
        Width="520" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!-- Come il design (canvas "Nuova partita"): il giocatore si sceglie tra pastiglie. -->
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style Selector="ListBox.chips">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="6,0,12,0" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- Modello proprio: quello del tema aggiunge la barretta di selezione a sinistra. -->
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="28,24" Spacing="16">


    <StackPanel Spacing="6" IsVisible="{Binding ShowName}">
      <TextBlock Classes="label" Text="{loc:Str CaptionProfileName}" />
      <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="14" />
      <TextBlock Classes="small" Text="{Binding HintText}" IsVisible="{Binding !HintIsError}"
                 Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
      <TextBlock FontSize="12" Text="{Binding HintText}" IsVisible="{Binding HintIsError}"
                 Foreground="{StaticResource Error}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Solo per una partita nuova con più persone: di chi è. -->
    <StackPanel IsVisible="{Binding ShowPlayer}" Spacing="6">
      <TextBlock Classes="label" Text="{Binding PlayerCaption}" />
      <ListBox Classes="chips" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
               SelectionMode="AlwaysSelected" Margin="0,0,0,-8">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:Person">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Color, Converter={x:Static vm:PersonConverters.Brush}}">
                <TextBlock Text="{Binding Name, Converter={x:Static vm:PersonConverters.Initial}}" FontSize="11" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <!-- Solo per una partita nuova: da dove parte (di default vuota). -->
    <StackPanel IsVisible="{Binding !IsRename}" Spacing="8">
      <TextBlock Classes="label" Text="{loc:Str CaptionContent}" />
      <RadioButton GroupName="Content" Content="{loc:Str EmptyProfileOption}"
                   IsChecked="{Binding EmptyProfile, Mode=TwoWay}" />

      <RadioButton GroupName="Content" Content="{loc:Str NewCopyOf}" IsVisible="{Binding ShowCopyOption}"
                   IsChecked="{Binding CopyOfOption, Mode=TwoWay}" />
      <ComboBox IsVisible="{Binding CopyOfOption}" ItemsSource="{Binding Sources}"
                SelectedItem="{Binding SelectedSource, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="28,0,0,0">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CopySource">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <RadioButton GroupName="Content" Content="{loc:Str NewImportFrom}"
                   IsChecked="{Binding ImportOption, Mode=TwoWay}" />
      <StackPanel IsVisible="{Binding ImportOption}" Orientation="Horizontal" Spacing="12" Margin="28,0,0,0">
        <Button Classes="secondary" Content="{loc:Str NewChooseFile}" Command="{Binding ChooseImportFileCommand}" />
        <TextBlock Text="{Binding ImportFileText}" Classes="small" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="280" />
      </StackPanel>

      <CheckBox Content="{loc:Str ActivateNow}" IsChecked="{Binding ActivateNow, Mode=TwoWay}" Margin="0,6,0,0" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Classes="primary" Content="{Binding CreateText}" IsDefault="True" IsEnabled="{Binding CanCreate}"
              Click="Create_Click" />
    </StackPanel>

  </StackPanel>

</Window>
