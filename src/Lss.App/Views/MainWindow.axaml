<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Lss.App.Localization"
        xmlns:vm="using:Lss.App.ViewModels"
        xmlns:views="using:Lss.App.Views"
        x:Class="Lss.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Local Save Switcher"
        Width="860" Height="720"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Grid>

  <!-- La modalità avanzata: intestazione, colonna dei giochi, il gioco -->
  <DockPanel IsVisible="{Binding !IsSimple}">

    <!-- Intestazione -->
    <Border DockPanel.Dock="Top" Height="68" Background="{StaticResource Header}" Padding="16,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,16,14,16"
                Background="{StaticResource Accent}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="title" Text="LSS" />
          <TextBlock Classes="caption" Text="{Binding HeaderCaption}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="secondary" Content="{loc:Str AddGameButton}" Command="{Binding AddGameCommand}" />
          <Button Classes="secondary" Content="{loc:Str ImportConfig}" Command="{Binding ImportConfigCommand}" />
          <Button Classes="secondary" Content="{loc:Str PlayersButton}" Command="{Binding OpenPlayersCommand}" />
          <Button Classes="secondary" Content="{loc:Str SwitchToSimple}" Command="{Binding SwitchToSimpleCommand}" />
          <Button Classes="secondary" Content="{loc:Str SettingsButton}"
                  Command="{Binding CurrentGame.SettingsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Colonna dei giochi (nascosta se c'è un solo gioco supportato) -->
    <Border DockPanel.Dock="Left" Width="240" Background="{StaticResource Header}" Padding="12,16"
            IsVisible="{Binding ShowSidebar}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{loc:Str GamesCaption}" Margin="4,0,0,10" />

        <Expander DockPanel.Dock="Bottom" IsVisible="{Binding HasOtherGames}" Margin="0,12,0,0"
                  IsExpanded="{Binding OtherGamesExpanded, Mode=OneTime}"
                  HorizontalAlignment="Stretch">
          <Expander.Header>
            <TextBlock Classes="caption" Text="{loc:Str OtherGamesCaption}" />
          </Expander.Header>
          <!-- Possono essere tanti (per esempio tutti i giochi Proton di uno Steam Deck): si scorrono. -->
          <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding OtherGames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameItemViewModel">
                  <StackPanel Margin="0,4,0,8" Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding LauncherHeader}" IsVisible="{Binding HasLauncherHeader}" />
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                    <TextBlock Classes="small" Text="{Binding SupportText}" TextWrapping="Wrap" />
                    <Button Classes="secondary" Content="{loc:Str FindSaveFolder}" Command="{Binding FindFolderCommand}"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                    <Button Classes="secondary" Content="{loc:Str ChooseSaveFolder}" Command="{Binding ChooseFolderCommand}"
                            HorizontalAlignment="Stretch" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Expander>

        <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GameItemViewModel">
              <StackPanel Spacing="2">
              <TextBlock Classes="caption" Text="{Binding LauncherHeader}" IsVisible="{Binding HasLauncherHeader}" Margin="0,6,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                <Image Source="{Binding Icon}" Width="32" Height="32" IsVisible="{Binding HasIcon}" />
                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource SurfaceSelected}"
                        IsVisible="{Binding !HasIcon}">
                  <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontWeight="Bold" />
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Gioco selezionato, o il messaggio se non ce n'è nessuno -->
    <Grid>
      <TextBlock Text="{loc:Str NoSupportedGames}" TextWrapping="Wrap" Margin="24" MaxWidth="480"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding ShowNoGames}" />

      <ContentControl Content="{Binding CurrentGame}" IsVisible="{Binding !ShowNoGames}">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="vm:GameViewModel">
            <views:GameView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>

  </DockPanel>

  <!-- La modalità semplice: al posto di tutto il resto -->
  <ContentControl Content="{Binding Simple}" IsVisible="{Binding IsSimple}">
    <ContentControl.DataTemplates>
      <DataTemplate x:DataType="vm:SimpleViewModel">
        <views:SimpleView />
      </DataTemplate>
    </ContentControl.DataTemplates>
  </ContentControl>

  </Grid>

</Window>
