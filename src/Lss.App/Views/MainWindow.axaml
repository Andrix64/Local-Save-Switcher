<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Lss.App.Localization"
        xmlns:vm="using:Lss.App.ViewModels"
        xmlns:views="using:Lss.App.Views"
        xmlns:ctl="using:Lss.App.Controls"
        x:Class="Lss.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Local Save Switcher"
        Width="860" Height="720"
        MinWidth="640" MinHeight="560"
        Classes="main"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

  <!-- Angoli leggermente stondati (a schermo intero o ingrandita il codice li azzera). -->
  <Border x:Name="Frame" CornerRadius="20" ClipToBounds="True" Background="{StaticResource Background}"
          BorderBrush="{StaticResource Border}" BorderThickness="2">
  <Grid>

  <!-- La modalità avanzata: intestazione, colonna dei giochi, il gioco -->
  <DockPanel IsVisible="{Binding !IsSimple}">

    <!-- Intestazione -->
    <Border x:Name="HeaderBar" DockPanel.Dock="Top" Height="68" Background="{StaticResource Header}" Padding="12,0,16,0"
            PointerPressed="Header_PointerPressed">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <views:WindowButtons Grid.Column="0" Margin="0,0,16,0" />
        <Border Grid.Column="1" Width="4" CornerRadius="2" Margin="0,16,14,16"
                Background="{StaticResource Accent}" />
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="title" Text="LSS" />
          <TextBlock Classes="caption" Text="{Binding HeaderCaption}" />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="secondary" Content="{loc:Str AddGameButton}" Command="{Binding AddGameCommand}" />
          <Button Classes="iconbtn" Command="{Binding OpenLssSettingsCommand}"
                  ToolTip.Tip="{loc:Str SettingsButton}" AutomationProperties.Name="{loc:Str SettingsButton}">
            <Path Width="22" Height="22" Data="{StaticResource GearIcon}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Colonna dei giochi (nascosta se c'è un solo gioco supportato) -->
    <Border DockPanel.Dock="Left" Width="240" Background="{StaticResource Header}" Padding="12,16"
            IsVisible="{Binding ShowSidebar}">
      <DockPanel>
        <Expander DockPanel.Dock="Bottom" IsVisible="{Binding HasOtherGames}" Margin="0,12,0,0"
                  IsExpanded="{Binding OtherGamesExpanded, Mode=OneTime}"
                  HorizontalAlignment="Stretch">
          <Expander.Header>
            <TextBlock Classes="caption" Text="{loc:Str OtherGamesCaption}" />
          </Expander.Header>
          <!-- Possono essere tanti (per esempio tutti i giochi Proton di uno Steam Deck): si scorrono. -->
          <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding OtherRows}">
              <ItemsControl.DataTemplates>
                <DataTemplate x:DataType="vm:SidebarHeader">
                  <TextBlock Classes="sidebarHeader" Text="{Binding Text}" />
                </DataTemplate>
                <DataTemplate x:DataType="vm:GameItemViewModel">
                  <StackPanel Margin="0,4,0,8" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Image Source="{Binding Icon}" Width="26" Height="26" IsVisible="{Binding HasIcon}" />
                      <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource SurfaceSelected}"
                              IsVisible="{Binding !HasIcon}">
                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" />
                      </Border>
                      <ctl:MarqueeText Text="{Binding Name}" Foreground="{StaticResource TextMuted}" FontSize="13"
                                       Width="160" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="small" Text="{Binding SupportText}" TextWrapping="Wrap" />
                    <Button Classes="secondary" Content="{loc:Str FindSaveFolder}" Command="{Binding FindFolderCommand}"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                    <Button Classes="secondary" Content="{loc:Str ChooseSaveFolder}" Command="{Binding ChooseFolderCommand}"
                            HorizontalAlignment="Stretch" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>

          </ScrollViewer>
        </Expander>

        <ListBox x:Name="GamesList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.DataTemplates>
            <DataTemplate x:DataType="vm:SidebarHeader">
              <TextBlock Classes="sidebarHeader" Text="{Binding Text}" />
            </DataTemplate>
            <DataTemplate x:DataType="vm:GameItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="10" Height="40">
                <Image Source="{Binding Icon}" Width="26" Height="26" IsVisible="{Binding HasIcon}" />
                <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource SurfaceSelected}"
                        IsVisible="{Binding !HasIcon}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontWeight="Bold" />
                </Border>
                <ctl:MarqueeText Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13"
                                 Width="150" VerticalAlignment="Center">
                  <ctl:MarqueeText.IsActive>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                      <Binding Path="$parent[ListBoxItem].IsSelected" />
                      <Binding Path="$parent[ListBoxItem].IsPointerOver" />
                    </MultiBinding>
                  </ctl:MarqueeText.IsActive>
                </ctl:MarqueeText>
              </StackPanel>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>

      </DockPanel>
    </Border>

    <!-- Gioco selezionato, o il messaggio se non ce n'è nessuno -->
    <Grid>
      <TextBlock Text="{loc:Str NoSupportedGames}" TextWrapping="Wrap" Margin="24" MaxWidth="480"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding ShowNoGames}" />

      <ContentControl Content="{Binding CurrentGame}" IsVisible="{Binding !ShowNoGames}">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="vm:GameViewModel">
            <views:GameView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>

  </DockPanel>

  <!-- La modalità semplice: al posto di tutto il resto -->
  <ContentControl Content="{Binding Simple}" IsVisible="{Binding IsSimple}">
    <ContentControl.DataTemplates>
      <DataTemplate x:DataType="vm:SimpleViewModel">
        <views:SimpleView />
      </DataTemplate>
    </ContentControl.DataTemplates>
  </ContentControl>

  <!-- Senza cornice di sistema i bordi sottili ridimensionano la finestra. -->
  <Grid x:Name="ResizeGrips" IsVisible="{Binding FullScreen.IsWindowed}">
    <Grid.Styles>
      <Style Selector="Border.grip">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Grid.Styles>
    <Border Classes="grip" Tag="North" Height="5" VerticalAlignment="Top" Margin="8,0" Cursor="SizeNorthSouth" PointerPressed="Grip_PointerPressed" />
    <Border Classes="grip" Tag="South" Height="5" VerticalAlignment="Bottom" Margin="8,0" Cursor="SizeNorthSouth" PointerPressed="Grip_PointerPressed" />
    <Border Classes="grip" Tag="West" Width="5" HorizontalAlignment="Left" Margin="0,8" Cursor="SizeWestEast" PointerPressed="Grip_PointerPressed" />
    <Border Classes="grip" Tag="East" Width="5" HorizontalAlignment="Right" Margin="0,8" Cursor="SizeWestEast" PointerPressed="Grip_PointerPressed" />
    <Border Classes="grip" Tag="NorthWest" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="TopLeftCorner" PointerPressed="Grip_PointerPressed" />
    <Border Classes="grip" Tag="NorthEast" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="TopRightCorner" PointerPressed="Grip_PointerPressed" />
    <Border Classes="grip" Tag="SouthWest" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="BottomLeftCorner" PointerPressed="Grip_PointerPressed" />
    <Border Classes="grip" Tag="SouthEast" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner" PointerPressed="Grip_PointerPressed" />
  </Grid>

  </Grid>
  </Border>

</Window>
