<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Lss.App.Localization"
        xmlns:vm="using:Lss.App.ViewModels"
        x:Class="Lss.App.Views.HistoryWindow"
        x:DataType="vm:HistoryViewModel"
        Title="{Binding Heading}"
        Width="680" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- Una riga della cronologia: i punti salvati hanno lo sfondo più chiaro. -->
    <Style Selector="Border.historyrow">
      <Setter Property="Background" Value="{StaticResource Background}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8,8,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.historyrow.strong">
      <Setter Property="Background" Value="{StaticResource Surface}" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource Success}" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{StaticResource Error}" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="24,20,24,16">

    <TextBlock Text="{Binding Intro}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
               MaxWidth="620" Margin="0,0,0,16" HorizontalAlignment="Left" />

    <!-- Un punto nuovo, con il nome -->
    <TextBlock Classes="caption" Text="{Binding SavePointCaption}" Margin="2,0,0,6" />
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
              BorderThickness="1" CornerRadius="6" Padding="12,6">
        <TextBox x:Name="SaveNameBox" Text="{Binding SaveName, Mode=TwoWay}" MaxLength="50"
                 Background="Transparent" BorderThickness="0" FontSize="14" Padding="0,4" />
      </Border>
      <Button Grid.Column="1" Classes="primary" Content="{Binding SaveNowText}"
              Command="{Binding SavePointCommand}" IsEnabled="{Binding CanSave}"
              MinWidth="120" Margin="10,0,0,0" />
    </Grid>
    <TextBlock Classes="small" Text="{Binding SaveHint}" Foreground="{StaticResource TextMuted}"
               Margin="2,0,0,14" TextWrapping="Wrap" IsVisible="{Binding !SaveHintIsWarning}" />
    <TextBlock Text="{Binding SaveHint}" Foreground="{StaticResource Warning}" FontSize="12"
               Margin="2,0,0,14" TextWrapping="Wrap" IsVisible="{Binding SaveHintIsWarning}" />

    <!-- Elenco: punti, copie automatiche, copie di versioni precedenti -->
    <ScrollViewer MaxHeight="330">
      <StackPanel Margin="0,0,12,0">

        <TextBlock Classes="caption" Text="{Binding MyPointsCaption}" Margin="2,0,0,6" />
        <TextBlock Text="{Binding PointsEmptyText}" Foreground="{StaticResource TextMuted}" Margin="2,0,0,6"
                   IsVisible="{Binding ShowPointsEmpty}" />
        <ItemsControl ItemsSource="{Binding Points}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryRowViewModel">
              <Border Classes="historyrow strong">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="small" Text="{Binding DateText}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="secondary" Content="{loc:Str GoBackHere}"
                          Command="{Binding GoBackCommand}" IsEnabled="{Binding Enabled}"
                          VerticalAlignment="Center" Margin="8,0,0,0" />
                  <Button Grid.Column="2" Classes="secondary" Content="{loc:Str Delete}" Command="{Binding DeleteCommand}"
                          IsEnabled="{Binding Enabled}" IsVisible="{Binding HasDelete}"
                          AutomationProperties.Name="{Binding DeleteName}"
                          VerticalAlignment="Center" Margin="4,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="caption" Text="{Binding AutomaticCopiesCaption}" Margin="2,14,0,6" />
        <TextBlock Text="{Binding NoCopiesText}" Foreground="{StaticResource TextMuted}" Margin="2,0,0,6"
                   IsVisible="{Binding ShowNoCopies}" />
        <ItemsControl ItemsSource="{Binding Copies}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryRowViewModel">
              <Border Classes="historyrow">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="small" Text="{Binding DateText}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="link" Content="{loc:Str GoBackHere}"
                          Command="{Binding GoBackCommand}" IsEnabled="{Binding Enabled}"
                          VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding ShowLegacy}">
          <TextBlock Classes="caption" Text="{Binding LegacyCaption}" Margin="2,14,0,6" />
          <ItemsControl ItemsSource="{Binding LegacyCopies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HistoryRowViewModel">
                <Border Classes="historyrow">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Classes="small" Text="{Binding DateText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="link" Content="{loc:Str GoBackHere}"
                            Command="{Binding GoBackCommand}" IsEnabled="{Binding Enabled}"
                            VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Piè di pagina: copie da tenere, esito dell'ultima operazione, chiudi -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
        <TextBlock Classes="small" Text="{Binding KeepText}" Foreground="{StaticResource TextMuted}"
                   VerticalAlignment="Center" />
        <Button Classes="link" Content="{Binding ChangeText}" Command="{Binding SettingsCommand}"
                FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="small" TextWrapping="Wrap"
                 Classes.ok="{Binding StatusIsSuccess}" Classes.bad="{Binding StatusIsError}"
                 Margin="10,0,10,0" VerticalAlignment="Center" />
    </Grid>

  </StackPanel>

</Window>
