<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lss.App.ViewModels"
        x:Class="Lss.App.Views.FirstRunWindow"
        x:DataType="vm:FirstRunViewModel"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="36,30,36,28">

    <TextBlock Text="{Binding Intro}" Foreground="#D8D8DC" TextWrapping="Wrap" Margin="0,0,0,20" />

    <TextBlock Classes="caption" Text="{Binding NameCaption}" Margin="2,0,0,6" />
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="6" Padding="12,6" Margin="0,0,0,6">
      <TextBox Text="{Binding Name, Mode=TwoWay}" MaxLength="50" Background="Transparent" BorderThickness="0"
               FontSize="14" Padding="0,4" />
    </Border>

    <TextBlock Classes="small" Text="{Binding HintText}" IsVisible="{Binding !HintIsError}"
               Foreground="{StaticResource TextMuted}" Margin="2,0,0,18" TextWrapping="Wrap" />
    <TextBlock FontSize="12" Text="{Binding HintText}" IsVisible="{Binding HintIsError}"
               Foreground="{StaticResource Error}" Margin="2,0,0,18" TextWrapping="Wrap" />

    <TextBlock Text="{Binding AccountLine}" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
    <TextBlock Text="{Binding CloudLine}" TextWrapping="Wrap" Margin="0,0,0,8"
               Foreground="{StaticResource TextSecondary}" />

    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,14,0,0">
      <Button Classes="primary" Content="{Binding StartText}" IsDefault="True" IsEnabled="{Binding CanStart}"
              MinWidth="140" Click="Start_Click" />
      <Button Classes="link" Content="{Binding SkipText}" IsCancel="True" VerticalAlignment="Center"
              Click="Skip_Click" />
    </StackPanel>

  </StackPanel>

</Window>
