<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Lss.App.Localization"
        xmlns:vm="using:Lss.App.ViewModels"
        x:Class="Lss.App.Views.GameSettingsWindow"
        x:DataType="vm:GameSettingsViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="28,0,0,8" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="24,20,24,18">

    <TextBlock Classes="caption" Text="{Binding CaptionGame}" Margin="2,0,0,6" />
    <CheckBox Content="{Binding LaunchText}" IsChecked="{Binding LaunchGame, Mode=TwoWay}" FontWeight="SemiBold" />
    <TextBlock Classes="hint" Text="{Binding LaunchHint}" />
    <CheckBox Content="{Binding SaveOnExitText}" IsChecked="{Binding SaveOnExit, Mode=TwoWay}" FontWeight="SemiBold" />
    <TextBlock Classes="hint" Text="{Binding SaveOnExitHint}" />
    <CheckBox Content="{Binding ShareText}" IsChecked="{Binding ShareOptions, Mode=TwoWay}" FontWeight="SemiBold" />
    <TextBlock Classes="hint" Text="{Binding ShareHint}" Margin="28,0,0,10" />

    <!-- File uguali in tutte le partite -->
    <TextBlock Classes="caption" Text="{Binding SharedFilesCaption}" Margin="28,0,0,6" />
    <ItemsControl ItemsSource="{Binding SharedFiles}" Margin="28,0,0,6">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SharedFileItemViewModel">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="{Binding Path}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="link" Content="{loc:Str RemoveSharedFile}"
                    Command="{Binding RemoveCommand}" Margin="10,0,0,0" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Classes="secondary" Content="{Binding AddSharedFileText}" Command="{Binding AddSharedFileCommand}"
            HorizontalAlignment="Left" Margin="28,0,0,18" />

    <!-- Copie automatiche -->
    <TextBlock Classes="caption" Text="{Binding CaptionCopies}" Margin="2,0,0,6" />
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
      <TextBlock Text="{Binding KeepText}" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding KeepCopies, Mode=TwoWay}" Minimum="0" Maximum="999" Width="110" />
    </StackPanel>
    <TextBlock Classes="small" Text="{Binding KeepHint}" Margin="2,0,0,18" TextWrapping="Wrap" />

    <Button Classes="link" Content="{Binding IgnoredFoldersText}" Command="{Binding OpenIgnoredFoldersCommand}"
            HorizontalAlignment="Left" Margin="0,0,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,22,0,0">
      <Button Classes="secondary" Content="{Binding CancelText}" IsCancel="True" MinWidth="110"
              Click="Cancel_Click" />
      <Button Classes="primary" Content="{Binding SaveText}" IsDefault="True" MinWidth="110"
              Click="Save_Click" />
    </StackPanel>

  </StackPanel>

</Window>
