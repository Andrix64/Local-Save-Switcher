<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lss.App.ViewModels"
        x:Class="Lss.App.Views.DeletedWindow"
        x:DataType="vm:DeletedViewModel"
        Title="{Binding Title}"
        Width="600" Height="470"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource Success}" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{StaticResource Error}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{StaticResource Warning}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="20,18,20,16">

    <!-- Chiudi, recupera, apri la cartella e l'esito dell'ultima operazione -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Grid.Column="0" Text="{Binding Status}" Classes="small" TextWrapping="Wrap"
                 Classes.ok="{Binding StatusIsSuccess}" Classes.bad="{Binding StatusIsError}"
                 Classes.warn="{Binding StatusIsWarning}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Button Classes="secondary" Content="{Binding PurgeText}" Command="{Binding PurgeCommand}"
                IsEnabled="{Binding CanUse}" Foreground="{StaticResource Error}" />
        <Button Classes="secondary" Content="{Binding PurgeAllText}" Command="{Binding PurgeAllCommand}"
                IsVisible="{Binding ShowPurgeAll}" IsEnabled="{Binding !Busy}" Foreground="{StaticResource Error}" />
        <Button Classes="primary" Content="{Binding RecoverText}" Command="{Binding RecoverCommand}"
                IsEnabled="{Binding CanUse}" MinWidth="120" />
        <Button Classes="secondary" Content="{Binding OpenFolderText}" Command="{Binding OpenFolderCommand}"
                IsEnabled="{Binding CanUse}" />
        <Button Classes="secondary" Content="{Binding CloseText}" IsCancel="True" MinWidth="100"
                Click="Close_Click" />
      </StackPanel>
    </Grid>

    <TextBlock DockPanel.Dock="Top" Classes="caption" Text="{Binding Caption}" Margin="2,0,0,4" />
    <TextBlock DockPanel.Dock="Top" Classes="small" Text="{Binding Intro}" TextWrapping="Wrap" Margin="2,0,0,8" />

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="10" Padding="6">
      <Grid>
        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextMuted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowEmpty}" />
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsVisible="{Binding ListVisible}"
                 Background="Transparent" BorderThickness="0" DoubleTapped="List_DoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DeletedItemViewModel">
              <StackPanel Margin="6,4" Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="18" Height="18" CornerRadius="9" Background="{Binding OwnerBrush}">
                    <TextBlock Text="{Binding OwnerInitial}" FontSize="11" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Classes="small" Text="{Binding OwnerText}" />
                </StackPanel>
                <TextBlock Classes="small" Text="{Binding Details}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

  </DockPanel>

</Window>
