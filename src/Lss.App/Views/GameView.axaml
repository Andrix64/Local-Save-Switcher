<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lss.App.Localization"
             xmlns:vm="using:Lss.App.ViewModels"
             xmlns:views="using:Lss.App.Views"
             x:Class="Lss.App.Views.GameView"
             x:DataType="vm:GameViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="24,16,24,12">

    <!-- Steam Cloud attivo per il gioco -->
    <Border Grid.Row="0" Classes="infobar warning" Margin="0,0,0,8" IsVisible="{Binding ShowCloudBar}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="{Binding CloudBarTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CloudBarText}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Content="{loc:Str CloudBarAction}"
                Command="{Binding CloudHelpCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <!-- Gioco aperto: come gestirlo -->
    <Border Grid.Row="1" Classes="infobar info" Margin="0,0,0,8" IsVisible="{Binding ShowGameBar}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding GameBarTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding GameBarText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Titolo dell'elenco e azioni -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,8">
      <TextBlock Grid.Column="0" Classes="heading" Text="{loc:Str YourPlaythroughs}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary" Content="{loc:Str ImportButton}"
                Command="{Binding ImportCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Classes="primary" Content="{loc:Str NewPlaythroughButton}"
                Command="{Binding NewCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <!-- Dove sono i salvataggi del gioco, e da dove li ha trovati LSS -->
    <StackPanel Grid.Row="3" Spacing="2" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="link" Content="{Binding SaveFolderText}" Command="{Binding OpenSaveFolderCommand}"
                FontSize="12" />
        <Button Classes="more" IsVisible="{Binding ShowAutomaticFolder}"
                AutomationProperties.Name="{loc:Str SaveFolderMenu}">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <Ellipse />
            <Ellipse />
            <Ellipse />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{loc:Str UseAutomaticFolder}" Command="{Binding UseAutomaticFolderCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <TextBlock Text="{Binding UserdataNotice}" IsVisible="{Binding ShowUserdataNotice}" TextWrapping="Wrap"
                 FontSize="12" Foreground="{StaticResource TextMuted}" />
      <!-- Altre cartelle dei salvataggi: un posto per riga -->
      <ItemsControl ItemsSource="{Binding SpotLines}" Margin="0,4,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SpotLine">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="link" Content="{Binding Text}" Command="{Binding OpenCommand}" FontSize="12" />
              <Button Classes="more" IsVisible="{Binding Removable}" AutomationProperties.Name="{loc:Str SaveFolderMenu}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Ellipse />
                  <Ellipse />
                  <Ellipse />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{loc:Str RemoveSpot}" Command="{Binding RemoveCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPendingSuggestions}">
        <TextBlock Text="{Binding SuggestionsPendingText}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
        <Button Classes="link" Content="{loc:Str SuggestionsLook}" Command="{Binding LookAtSuggestionsCommand}" FontSize="12" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="link" Content="{loc:Str AddSpot}" Command="{Binding AddSpotCommand}"
                IsEnabled="{Binding !IsBusy}" FontSize="12" />
        <Button Classes="link" Content="{loc:Str ExportConfig}" Command="{Binding ExportConfigCommand}"
                IsEnabled="{Binding !IsBusy}" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <!-- Le schede delle partite -->
    <ScrollViewer Grid.Row="4">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Playthroughs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PlaythroughViewModel">
              <views:PlaythroughCardView />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextMuted}" Margin="2,8,0,0" />

        <Button Classes="link" Content="{Binding DeletedLinkText}" Command="{Binding ShowDeletedCommand}"
                IsVisible="{Binding ShowDeletedLink}" FontSize="12" Margin="2,4,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- Avviso dell'ultima operazione -->
    <Border Grid.Row="5" Classes="infobar" Margin="0,6,0,0" IsVisible="{Binding Toast.IsVisible}"
            Classes.info="{Binding Toast.IsInfo}"
            Classes.warning="{Binding Toast.IsWarning}"
            Classes.success="{Binding Toast.IsSuccess}"
            Classes.error="{Binding Toast.IsError}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Toast.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="secondary" Content="{Binding Toast.ActionText}"
                IsVisible="{Binding Toast.HasAction}" Command="{Binding Toast.RunActionCommand}"
                VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>

  </Grid>

</UserControl>
