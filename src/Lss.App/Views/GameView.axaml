<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Lss.App.Localization"
             xmlns:vm="using:Lss.App.ViewModels"
             xmlns:views="using:Lss.App.Views"
             x:Class="Lss.App.Views.GameView"
             x:DataType="vm:GameViewModel">

  <!-- Come il design (canvas "Avanzata"). -->
  <UserControl.Styles>
    <Style Selector="Button.folderToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.folderToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.path">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#D6D6DA" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.path:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Path.folder">
      <Setter Property="Data" Value="M3 6 H9 L11 8 H21 V19 H3 Z" />
      <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="24,16,24,12">

    <!-- Steam Cloud attivo per il gioco -->
    <Border Grid.Row="0" Classes="infobar warning" Margin="0,0,0,8" IsVisible="{Binding ShowCloudBar}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="{Binding CloudBarTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CloudBarText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Classes="secondary" Content="{loc:Str CloudBarAction}" Command="{Binding CloudHelpCommand}" />
          <!-- Un admin consente il gioco anche in modalità semplice (CloudConsentito). -->
          <Button Classes="link" Content="{loc:Str CloudAllowSimple}" Command="{Binding AllowCloudInSimpleCommand}"
                  IsVisible="{Binding !CloudAllowedInSimple}" />
          <StackPanel Spacing="6" IsVisible="{Binding CloudAllowedInSimple}">
            <TextBlock Text="{loc:Str CloudAllowedSimple}" TextWrapping="Wrap" FontSize="12" />
            <Button Classes="link" Content="{loc:Str CloudAllowUndo}" Command="{Binding UndoAllowCloudInSimpleCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Gioco aperto: come gestirlo -->
    <Border Grid.Row="1" Classes="infobar info" Margin="0,0,0,8" IsVisible="{Binding ShowGameBar}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding GameBarTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding GameBarText}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Proposte dopo l'ultima partita: barra blu con Guarda -->
    <Border Grid.Row="2" Classes="infobar info" Margin="0,0,0,10" IsVisible="{Binding HasPendingSuggestions}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="{Binding SuggestionsPendingText}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="secondary" Content="{loc:Str SuggestionsLook}" Command="{Binding LookAtSuggestionsCommand}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Dove sono i salvataggi del gioco, e da dove li ha trovati LSS: un riquadro che parte chiuso -->
    <Border Grid.Row="3" Background="Transparent" Padding="0,2" Margin="0,0,0,12">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <Button Classes="folderToggle" Command="{Binding ToggleSaveFoldersCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="M9 6 L15 12 L9 18" Stroke="{StaticResource TextMuted}" StrokeThickness="2" StrokeLineCap="Round"
                    StrokeJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                    IsVisible="{Binding !SaveFoldersOpen}" />
              <Path Data="M6 9 L12 15 L18 9" Stroke="{StaticResource TextMuted}" StrokeThickness="2" StrokeLineCap="Round"
                    StrokeJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                    IsVisible="{Binding SaveFoldersOpen}" />
              <TextBlock Text="{Binding SaveFoldersHeader}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding SaveFoldersOpen}">
            <Button Classes="link" Content="{loc:Str ExportConfig}" Command="{Binding ExportConfigCommand}"
                    IsEnabled="{Binding !IsBusy}" FontSize="12" />
            <Button Classes="link" Command="{Binding AddSpotCommand}" IsEnabled="{Binding !IsBusy}" FontSize="12">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="+" />
                <TextBlock Text="{loc:Str AddSpot}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="2" Margin="0,0,0,4" IsVisible="{Binding SaveFoldersOpen}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Path Classes="folder" />
            <Button Classes="path" Command="{Binding OpenSaveFolderCommand}">
              <TextBlock Text="{Binding SaveFolderText}" TextWrapping="Wrap" MaxWidth="640" />
            </Button>
            <Button Classes="more" IsVisible="{Binding ShowAutomaticFolder}"
                    AutomationProperties.Name="{loc:Str SaveFolderMenu}">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Ellipse />
                <Ellipse />
                <Ellipse />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="{loc:Str UseAutomaticFolder}" Command="{Binding UseAutomaticFolderCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding UserdataNotice}" IsVisible="{Binding ShowUserdataNotice}" TextWrapping="Wrap"
                     FontSize="12" Foreground="{StaticResource TextMuted}" Margin="25,0,0,0" />
          <!-- Altre cartelle dei salvataggi: un posto per riga -->
          <ItemsControl ItemsSource="{Binding SpotLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SpotLine">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="folder" />
                  <Button Classes="path" Command="{Binding OpenCommand}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="640" />
                  </Button>
                  <Button Classes="more" IsVisible="{Binding Removable}" AutomationProperties.Name="{loc:Str SaveFolderMenu}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                      <Ellipse />
                      <Ellipse />
                      <Ellipse />
                    </StackPanel>
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="{loc:Str RemoveSpot}" Command="{Binding RemoveCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Titolo dell'elenco e azioni -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,10">
      <!-- Il titolo si accorcia con "…" quando la finestra è stretta, senza finire sotto i pulsanti. -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{Binding Manager.Game.Name}" FontSize="28" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="caption" Text="{loc:Str YourPlaythroughs}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <!-- Impostazioni del gioco: l'ingranaggio sopra un floppy -->
        <Button Classes="iconbtn" Command="{Binding GameSettingsCommand}" VerticalAlignment="Center"
                ToolTip.Tip="{loc:Str GameSettingsButton}" AutomationProperties.Name="{loc:Str GameSettingsButton}">
          <Panel Width="24" Height="24">
            <Path Data="{StaticResource FloppyIcon}" Width="22" Height="22" HorizontalAlignment="Left"
                  VerticalAlignment="Top" />
            <Ellipse Width="14" Height="14" Fill="{StaticResource Background}" HorizontalAlignment="Right"
                     VerticalAlignment="Bottom" />
            <Path Data="{StaticResource GearIcon}" Width="13" Height="13" StrokeThickness="2"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Panel>
        </Button>
        <Button Classes="primary" Content="{loc:Str NewPlaythroughButton}"
                Command="{Binding NewCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
    </Grid>

    <!-- Le schede delle partite -->
    <ScrollViewer Grid.Row="5">
      <StackPanel>
        <!-- Le partite per persona: intestazione col colore, poi le schede (la preferita per prima). -->
        <ItemsControl ItemsSource="{Binding PlayerGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PlayerGroup">
              <StackPanel Spacing="6" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,2,2,0">
                  <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Brush}">
                    <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding Person.Name}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Cards}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaythroughViewModel">
                      <views:PlaythroughCardView />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource TextMuted}" Margin="2,8,0,0" />

        <Button Classes="link" Content="{Binding DeletedLinkText}" Command="{Binding ShowDeletedCommand}"
                IsVisible="{Binding ShowDeletedLink}" FontSize="12" Margin="2,4,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- Avviso dell'ultima operazione -->
    <Border Grid.Row="6" Classes="infobar" Margin="0,6,0,0" IsVisible="{Binding Toast.IsVisible}"
            Classes.info="{Binding Toast.IsInfo}"
            Classes.warning="{Binding Toast.IsWarning}"
            Classes.success="{Binding Toast.IsSuccess}"
            Classes.error="{Binding Toast.IsError}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Toast.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="secondary" Content="{Binding Toast.ActionText}"
                IsVisible="{Binding Toast.HasAction}" Command="{Binding Toast.RunActionCommand}"
                VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Border>

  </Grid>

</UserControl>
