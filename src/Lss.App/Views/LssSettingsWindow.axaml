<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lss.App.ViewModels"
        x:Class="Lss.App.Views.LssSettingsWindow"
        x:DataType="vm:LssSettingsViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="28,0,0,8" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="24,20,24,18">

    <!-- Dopo ogni partita: altre cartelle dei salvataggi (impostazione di tutto il programma) -->
    <CheckBox Content="{Binding LookAfterPlayingText}" IsChecked="{Binding LookAfterPlaying, Mode=TwoWay}"
              FontWeight="SemiBold" />
    <TextBlock Classes="hint" Text="{Binding LookAfterPlayingHint}" Margin="28,0,0,18" />

    <!-- Cartella dei dati e informazioni -->
    <TextBlock Classes="caption" Text="{Binding CaptionData}" Margin="2,0,0,6" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="{Binding DataFolderText}" Classes="small" TextWrapping="Wrap" MaxWidth="400"
                 VerticalAlignment="Center" HorizontalAlignment="Left" />
      <Button Classes="secondary" Content="{Binding OpenFolderText}" Command="{Binding OpenFolderCommand}"
              VerticalAlignment="Center" />
    </StackPanel>
    <Button Classes="link" Content="{Binding IgnoredFoldersText}" Command="{Binding OpenIgnoredFoldersCommand}"
            HorizontalAlignment="Left" Margin="0,8,0,0" />
    <Button Classes="link" Content="{Binding ExportAllText}" Command="{Binding ExportAllCommand}"
            HorizontalAlignment="Left" Margin="0,4,0,0" />
    <Button Classes="link" Content="{Binding PlayersText}" Command="{Binding OpenPlayersCommand}"
            HorizontalAlignment="Left" Margin="0,4,0,0" />
    <TextBlock Classes="small" Text="{Binding AboutText}" Foreground="{StaticResource TextMuted}"
               TextWrapping="Wrap" Margin="2,8,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,22,0,0">
      <Button Classes="secondary" Content="{Binding CancelText}" IsCancel="True" MinWidth="110"
              Click="Cancel_Click" />
      <Button Classes="primary" Content="{Binding SaveText}" IsDefault="True" MinWidth="110"
              Click="Save_Click" />
    </StackPanel>

  </StackPanel>

</Window>
