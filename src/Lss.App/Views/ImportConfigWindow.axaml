<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Lss.App.Localization"
        xmlns:vm="using:Lss.App.ViewModels"
        x:Class="Lss.App.Views.ImportConfigWindow"
        x:DataType="vm:ImportConfigViewModel"
        Title="{Binding Title}"
        Width="580" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="22,20" Spacing="12">

    <!-- Un blocco per gioco del file -->
    <ScrollViewer MaxHeight="460" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConfigGameItem">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanImport}"
                          IsVisible="{Binding HasGame}" Content="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Name}" IsVisible="{Binding !HasGame}" FontWeight="SemiBold" />
                <TextBlock Classes="small" Text="{Binding MissingText}" IsVisible="{Binding !HasGame}"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                <TextBlock Classes="small" Text="{Binding LauncherText}" IsVisible="{Binding HasLauncherText}"
                           Foreground="{StaticResource TextMuted}" />
                <TextBlock Classes="small" Text="{Binding MadeOnText}" Foreground="{StaticResource TextMuted}" />
                <TextBlock Classes="small" Text="{Binding WindowsInPrefixText}" IsVisible="{Binding HasWindowsInPrefix}"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding NotesText}" IsVisible="{Binding HasNotes}" TextWrapping="Wrap" />

                <!-- Un rigo per posto: la cartella qui e il suo stato -->
                <ItemsControl ItemsSource="{Binding Spots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConfigSpotRow">
                      <StackPanel Spacing="2" Margin="0,2,0,2">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Classes="small" Text="{Binding StateText}" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Classes="secondary" Content="{Binding CancelText}" IsCancel="True" MinWidth="110"
              Command="{Binding CancelCommand}" />
      <Button Classes="primary" Content="{Binding ImportText}" IsDefault="True" MinWidth="110"
              Command="{Binding ImportCommand}" />
    </StackPanel>

  </StackPanel>

</Window>
