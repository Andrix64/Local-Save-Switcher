<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Lss.App.Localization">

  <!-- Colori del tema scuro con accento rosso (Theme.cs di WinForms, stessi nomi). -->
  <Styles.Resources>
    <SolidColorBrush x:Key="Background">#0F0F10</SolidColorBrush>
    <SolidColorBrush x:Key="Header">#0A0A0B</SolidColorBrush>
    <SolidColorBrush x:Key="Surface">#19191B</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceHover">#232326</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceSelected">#2C2C30</SolidColorBrush>
    <SolidColorBrush x:Key="Border">#2E2E33</SolidColorBrush>
    <SolidColorBrush x:Key="Text">#F2F2F2</SolidColorBrush>
    <SolidColorBrush x:Key="TextMuted">#96969C</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondary">#A8A8AE</SolidColorBrush>
    <SolidColorBrush x:Key="TextDisabled">#5A5A60</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#E0261B</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHover">#F03C30</SolidColorBrush>
    <SolidColorBrush x:Key="AccentPressed">#B81E15</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSoft">#3E1816</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSoftText">#FF8076</SolidColorBrush>
    <SolidColorBrush x:Key="Success">#4CC38A</SolidColorBrush>
    <SolidColorBrush x:Key="Warning">#F5B83D</SolidColorBrush>
    <SolidColorBrush x:Key="Error">#FF5C5C</SolidColorBrush>
    <SolidColorBrush x:Key="InfoBlue">#7FB0F0</SolidColorBrush>
    <SolidColorBrush x:Key="InfoBack">#1B2230</SolidColorBrush>
    <SolidColorBrush x:Key="InfoBorder">#34507A</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBack">#2A2110</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBorder">#5C4515</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBack">#18261F</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBorder">#2E5C44</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBack">#2E1717</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBorder">#6B2B2B</SolidColorBrush>
    <SolidColorBrush x:Key="DangerBorder">#7A2A24</SolidColorBrush>
    <SolidColorBrush x:Key="DangerText">#FFB4AD</SolidColorBrush>
    <!-- Pulsante per le azioni distruttive: rosso più scuro, il testo bianco si legge. -->
    <SolidColorBrush x:Key="Danger">#B3261E</SolidColorBrush>
    <SolidColorBrush x:Key="DangerHover">#C93A30</SolidColorBrush>
    <SolidColorBrush x:Key="DangerPressed">#8F1D17</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryHover">#38383D</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryPressed">#242428</SolidColorBrush>
    <!-- Icone a tratto (griglia 24x24, stile Lucide), colorate dal Foreground del pulsante. -->
    <StreamGeometry x:Key="GearIcon">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z</StreamGeometry>
    <StreamGeometry x:Key="FloppyIcon">M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7 M7 3v4a1 1 0 0 0 1 1h7</StreamGeometry>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Background}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Testi: corpi di Theme.cs in pixel (punti × 96/72). -->
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <!-- Titolo di un launcher nella colonna dei giochi (R4): riga a sé, non selezionabile. -->
  <Style Selector="TextBlock.sidebarHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Margin" Value="6,12,6,6" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.note">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Foreground" Value="#D8D8DC" />
    <!-- Il corsivo sporge a destra: senza margine l'ultima lettera viene tagliata. -->
    <Setter Property="Padding" Value="0,0,3,0" />
  </Style>

  <!-- Pulsanti: testo sempre al centro, anche quando sono più larghi del testo (MinWidth). -->
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentPressed}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{StaticResource SurfaceSelected}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryHover}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryPressed}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource Danger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource DangerPressed}" />
  </Style>

  <!-- "⋯" delle schede: stessa altezza degli altri pulsanti, tre puntini disegnati al centro. -->
  <Style Selector="Button.more">
    <Setter Property="Background" Value="{StaticResource SurfaceSelected}" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryHover}" />
  </Style>
  <Style Selector="Button.more Ellipse">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="Fill" Value="{StaticResource Text}" />
  </Style>

  <!-- Elenchi (giochi, account, partite eliminate): selezione con i colori dell'app, non quelli di sistema. -->
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource AccentSoftText}" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- Schede delle partite. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,14,14,14" />
  </Style>
  <Style Selector="Border.card.active">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- Etichetta "IN THE GAME NOW". -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,1" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Barre informative (come InfoBar di WinForms). -->
  <Style Selector="Border.infobar">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.infobar.info">
    <Setter Property="Background" Value="{StaticResource InfoBack}" />
    <Setter Property="BorderBrush" Value="{StaticResource InfoBorder}" />
  </Style>
  <Style Selector="Border.infobar.warning">
    <Setter Property="Background" Value="{StaticResource WarningBack}" />
    <Setter Property="BorderBrush" Value="{StaticResource WarningBorder}" />
  </Style>
  <Style Selector="Border.infobar.success">
    <Setter Property="Background" Value="{StaticResource SuccessBack}" />
    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
  </Style>
  <Style Selector="Border.infobar.error">
    <Setter Property="Background" Value="{StaticResource ErrorBack}" />
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBorder}" />
  </Style>

  <!-- Pulsanti con la sola icona (impostazioni, tasti della finestra). -->
  <Style Selector="Button.iconbtn">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceSelected}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.iconbtn.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.iconbtn Path">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- Finestre delle impostazioni: pannelli senza fronzoli, una riga per impostazione con l'interruttore a destra. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,4" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Border}" />
  </Style>
  <Style Selector="Grid.row">
    <Setter Property="Margin" Value="0,12" />
  </Style>
  <Style Selector="TextBlock.settingTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.settingHint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.sectionLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Margin" Value="4,18,0,8" />
  </Style>
  <!-- Interruttore con l'accento dell'app e senza il testo "On/Off". -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Margin" Value="16,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{StaticResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
  </Style>


  <!-- Telaio dei popup: niente cornice di sistema, angoli a 20px come la finestra principale, in alto il titolo
       leggibile e la X per chiudere. Trascinamento ed Esc li gestisce PopupChrome (App.axaml.cs). -->
  <Style Selector="Window:not(.main)">
    <Setter Property="WindowDecorations" Value="None" />
    <Setter Property="TransparencyLevelHint" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{StaticResource Background}" BorderBrush="{StaticResource Border}" BorderThickness="2"
                CornerRadius="20" ClipToBounds="True">
          <VisualLayerManager>
            <DockPanel>
              <Border x:Name="PART_PopupHeader" DockPanel.Dock="Top" Height="56" Background="{StaticResource Header}"
                      Padding="24,0,12,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold"
                             Foreground="{StaticResource Text}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Button x:Name="PART_PopupClose" Grid.Column="1" Classes="iconbtn close" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Str Close}" AutomationProperties.Name="{loc:Str Close}">
                    <Path Width="14" Height="14" Data="M5 5 L19 19 M19 5 L5 19" />
                  </Button>
                </Grid>
              </Border>
              <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}" />
            </DockPanel>
          </VisualLayerManager>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
