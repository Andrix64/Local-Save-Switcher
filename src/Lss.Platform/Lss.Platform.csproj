<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Simboli dentro la dll (e quindi nell'exe singolo): gli errori nel registro hanno i numeri di riga. -->
    <DebugType>embedded</DebugType>
    <RootNamespace>Lss</RootNamespace>
    <AssemblyName>Lss.Platform</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Come in Lss.App: una dll bloccata da Smart App Control passa ricompilando (hash diverso). -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lss.Core\Lss.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LSS" />
    <InternalsVisibleTo Include="Lss.Tests" />
    <InternalsVisibleTo Include="Lss.UiScreenshots" />
  </ItemGroup>

</Project>
